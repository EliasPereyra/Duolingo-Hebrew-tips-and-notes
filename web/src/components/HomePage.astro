---
import { getCollection } from "astro:content";
import LessonSearch from "./LessonSearch.astro";
import { ICONS } from "../constants/icons";
import { buildLessonIconMap } from "../utils/lesson-icons";
import { sortByCourseOrder } from "../utils/course-order";

interface Props {
  locale: "en" | "es";
}

const { locale } = Astro.props;
const prefix = locale === "es" ? "/es" : "";

const copy = {
  en: {
    title: "Hebrew Tips & Notes",
    subtitle:
      "Complete Tips and Notes from the Duolingo Hebrew course. These notes were removed from Duolingo and are preserved here as a reference.",
    start: "Start with",
    lessons: "All lessons",
    lessonsHint: "In course order",
    search: "Search lessons...",
    noResults: "No lessons match your search.",
  },
  es: {
    title: "Hebreo: Consejos y Notas",
    subtitle:
      "Consejos y notas completos del curso de hebreo de Duolingo. Estas notas fueron eliminadas de Duolingo y se conservan aquí como referencia.",
    start: "Empezar por",
    lessons: "Todas las lecciones",
    lessonsHint: "En el orden del curso",
    search: "Buscar lecciones...",
    noResults: "No se encontraron lecciones.",
  },
}[locale];

const enLessons = sortByCourseOrder(await getCollection("lessons"));
const lessons = locale === "es" ? sortByCourseOrder(await getCollection("lessonsEs")) : enLessons;
// Same icon/color per lesson as the sidebar (always derived from English titles).
const iconMap = buildLessonIconMap(enLessons);
const firstLesson = lessons[0];
---

<main>
  <header class="hero">
    <p class="hero-hebrew" lang="he" dir="rtl">טיפים והערות</p>
    <h1>{copy.title}</h1>
    <p class="subtitle">{copy.subtitle}</p>
    {
      firstLesson && (
        <a class="hero-cta" href={`${prefix}/lessons/${firstLesson.id}`}>
          {copy.start} {firstLesson.data.title}
          <span aria-hidden="true">→</span>
        </a>
      )
    }
    <p class="alefbet" lang="he" dir="rtl" aria-hidden="true">אבגדהוזחטיכלמנסעפצקרשת</p>
  </header>

  <section>
    <div class="section-heading">
      <h2>{copy.lessons}</h2>
      <span class="section-hint">{copy.lessonsHint} · {lessons.length}</span>
    </div>
    <LessonSearch placeholder={copy.search} noResultsText={copy.noResults} />
    <ol class="lesson-list" id="lesson-list">
      {
        lessons.map((lesson, index) => {
          const { icon, color } = iconMap.get(lesson.id)!;
          const LessonIcon = ICONS[icon as keyof typeof ICONS];
          return (
            <li data-title={lesson.data.title.toLowerCase()}>
              <a href={`${prefix}/lessons/${lesson.id}`}>
                <span class="lesson-number">{String(index + 1).padStart(2, "0")}</span>
                <LessonIcon size={18} color={color} class="lesson-icon" />
                <span class="lesson-title">{lesson.data.title}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>
</main>

<style>
  main {
    max-width: 880px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-14);
  }

  .hero {
    position: relative;
    margin-bottom: var(--space-16);
    padding-bottom: var(--space-14);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .hero-hebrew {
    font-family: var(--font-hebrew);
    font-size: clamp(2.5rem, 7vw, 4rem);
    line-height: 1.1;
    color: var(--color-clay);
    text-align: left;
    margin-bottom: var(--space-7);
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    line-height: 1.15;
    margin-bottom: var(--space-9);
  }

  .subtitle {
    max-width: 38rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-13);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-11);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: var(--font-weight-semibold);
    transition: background var(--transition-fast);

    &:hover {
      background: var(--color-accent-hover);
      text-decoration: none;
    }
  }

  /* Decorative alef-bet, fading out toward the reading direction's end. */
  .alefbet {
    margin-top: var(--space-14);
    font-family: var(--font-hebrew);
    font-size: var(--font-size-2xl);
    letter-spacing: 0.35em;
    color: var(--color-border);
    white-space: nowrap;
    overflow: hidden;
    mask-image: linear-gradient(to left, black 40%, transparent);
    user-select: none;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-9);
    margin-bottom: var(--space-9);
  }

  h2 {
    font-size: var(--font-size-2xl);
  }

  .section-hint {
    color: var(--color-text-subtle);
    font-size: var(--font-size-sm);
  }

  .lesson-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .lesson-list a {
    display: flex;
    align-items: center;
    gap: var(--space-7);
    height: 100%;
    padding: var(--space-7) var(--space-9);
    background: var(--color-example-bg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    color: var(--color-text-heading);
    font-size: var(--font-size-base);
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);

    &:hover {
      border-color: var(--color-accent);
      transform: translateY(-1px);
      text-decoration: none;
    }
  }

  .lesson-number {
    min-width: 1.6em;
    font-family: var(--font-serif);
    font-size: var(--font-size-sm);
    color: var(--color-clay);
    font-variant-numeric: tabular-nums;
  }

  .lesson-icon {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    main {
      padding: var(--space-12) var(--space-11);
    }

    .section-heading {
      flex-direction: column;
      gap: var(--space-1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lesson-list a {
      transition: none;

      &:hover {
        transform: none;
      }
    }
  }
</style>
