---
import { getCollection } from "astro:content";
import { buildLessonIconMap } from "../utils/lesson-icons";
import { ICONS } from "../constants/icons";

const lessons = await getCollection("lessons");
const pathname = Astro.url.pathname;
const iconMap = buildLessonIconMap(lessons);
---

<aside class="sidebar">
  <a href="/" class="logo">Hebrew Tips & Notes</a>
  <nav>
    <ul>
      {
        lessons.map((lesson) => {
          const href = `/lessons/${lesson.id}`;
          const isActive = pathname === href || pathname === `${href}/`;
          const { icon, color } = iconMap.get(lesson.id)!;
          const LessonIcon = ICONS[icon as keyof typeof ICONS];
          return (
            <li>
              <a href={href} class:list={{ active: isActive }}>
                <LessonIcon size={16} color={color} class="lesson-icon" />
                {lesson.data.title}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</aside>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const active = document.querySelector("nav a.active");
    if (active) {
      active.scrollIntoView({ block: "center" });
    }
  });
</script>

<style>
  .sidebar {
    width: 280px;
    min-width: 280px;
    height: 100vh;
    overflow-y: auto;
    background: #1a1d23;
    color: #c9d1d9;
    padding: 1rem 0;
    position: fixed;
    left: 0;
    top: 0;
  }

  .logo {
    display: block;
    padding: 0.75rem 1.25rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: #58a6ff;
    border-bottom: 1px solid #30363d;
    margin-bottom: 0.5rem;
  }

  nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  nav li {
    padding: 0;
  }

  nav a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.25rem;
    color: #8b949e;
    font-size: 0.875rem;
    transition: color 0.15s, background 0.15s;
  }

  .lesson-icon {
    flex-shrink: 0;
  }

  nav a:hover {
    color: #c9d1d9;
    background: #21262d;
  }

  nav a.active {
    color: #fff;
    background: #0366d6;
    font-weight: 600;
  }
</style>
