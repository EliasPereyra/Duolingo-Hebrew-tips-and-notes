---
import { getCollection } from "astro:content";
import { Menu, X } from "reicon-astro";
import { buildLessonIconMap } from "../utils/lesson-icons";
import { ICONS } from "../constants/icons";

const lessons = await getCollection("lessons");
const pathname = Astro.url.pathname;
const iconMap = buildLessonIconMap(lessons);
---

<button type="button" class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle sidebar" aria-expanded="false">
  <Menu size={22} class="icon-open" />
  <X size={22} class="icon-close" />
</button>

<div class="sidebar-backdrop" id="sidebar-backdrop"></div>

<aside class="sidebar" id="sidebar">
  <a href="/" class="logo">Hebrew Tips & Notes</a>
  <nav>
    <ul>
      {
        lessons.map((lesson) => {
          const href = `/lessons/${lesson.id}`;
          const isActive = pathname === href || pathname === `${href}/`;
          const { icon, color } = iconMap.get(lesson.id)!;
          const LessonIcon = ICONS[icon as keyof typeof ICONS];
          return (
            <li>
              <a href={href} class:list={{ active: isActive }}>
                <LessonIcon size={16} color={color} class="lesson-icon" />
                {lesson.data.title}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</aside>

<script>
  function initSidebar() {
    const sidebar = document.getElementById("sidebar");
    const toggle = document.getElementById("sidebar-toggle");
    const backdrop = document.getElementById("sidebar-backdrop");
    if (!sidebar || !toggle || !backdrop) return;

    const closeSidebar = () => {
      sidebar.classList.remove("open");
      backdrop.classList.remove("visible");
      toggle.setAttribute("aria-expanded", "false");
    };

    const openSidebar = () => {
      sidebar.classList.add("open");
      backdrop.classList.add("visible");
      toggle.setAttribute("aria-expanded", "true");
    };

    toggle.addEventListener("click", () => {
      if (sidebar.classList.contains("open")) {
        closeSidebar();
      } else {
        openSidebar();
      }
    });

    backdrop.addEventListener("click", closeSidebar);

    sidebar.querySelectorAll("nav a").forEach((link) => {
      link.addEventListener("click", closeSidebar);
    });

    const active = sidebar.querySelector("nav a.active");
    if (active) {
      active.scrollIntoView({ block: "center" });
    }
  }

  document.addEventListener("astro:page-load", initSidebar);
</script>

<style>
  .sidebar {
    width: 280px;
    min-width: 280px;
    height: 100vh;
    overflow-y: auto;
    background: #1a1d23;
    color: #c9d1d9;
    padding: 1rem 0;
    position: fixed;
    left: 0;
    top: 0;
  }

  .logo {
    display: block;
    padding: 0.75rem 1.25rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: #58a6ff;
    border-bottom: 1px solid #30363d;
    margin-bottom: 0.5rem;
  }

  nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  nav li {
    padding: 0;
  }

  nav a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.25rem;
    color: #8b949e;
    font-size: 0.875rem;
    transition: color 0.15s, background 0.15s;
  }

  .lesson-icon {
    flex-shrink: 0;
  }

  nav a:hover {
    color: #c9d1d9;
    background: #21262d;
  }

  nav a.active {
    color: #fff;
    background: #0366d6;
    font-weight: 600;
  }

  .sidebar-toggle {
    display: none;
    position: fixed;
    top: 0.75rem;
    left: 1rem;
    z-index: 1001;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    background: #1a1d23;
    color: #c9d1d9;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: left 0.25s ease;
  }

  .sidebar-toggle[aria-expanded="true"] {
    left: 226px;
  }

  .sidebar-toggle :global(.icon-close) {
    display: none;
  }

  .sidebar-toggle[aria-expanded="true"] :global(.icon-open) {
    display: none;
  }

  .sidebar-toggle[aria-expanded="true"] :global(.icon-close) {
    display: block;
  }

  .sidebar-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 999;
  }

  .sidebar-backdrop.visible {
    display: block;
  }

  @media (max-width: 768px) {
    .sidebar-toggle {
      display: flex;
    }

    .sidebar {
      transform: translateX(-100%);
      transition: transform 0.25s ease;
      z-index: 1000;
      box-shadow: 2px 0 16px rgba(0, 0, 0, 0.35);
    }

    .sidebar.open {
      transform: translateX(0);
    }
  }
</style>
