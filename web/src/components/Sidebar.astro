---
import { getCollection } from "astro:content";
import { Menu, X } from "reicon-astro";
import { buildLessonIconMap } from "../utils/lesson-icons";
import { ICONS } from "../constants/icons";
import logo from "../assets/imgs/logo.svg";

interface Props {
  locale?: "en" | "es";
}

const { locale = "en" } = Astro.props;
const prefix = locale === "es" ? "/es" : "";

const enLessons = await getCollection("lessons");
const lessons = locale === "es" ? await getCollection("lessonsEs") : enLessons;
const pathname = Astro.url.pathname;

// Icon/color assignment is always derived from the English titles so it stays
// consistent across locales (lesson ids are shared between collections).
const iconMap = buildLessonIconMap(enLessons);
---

<button type="button" class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle sidebar" aria-expanded="false">
  <Menu size={22} class="icon-open" />
  <X size={22} class="icon-close" />
</button>

<div class="sidebar-backdrop" id="sidebar-backdrop"></div>

<aside class="sidebar" id="sidebar">
  <a href={prefix || "/"} class="logo">
    <img src={logo.src} width={logo.width} height={logo.height} alt="Hebrew Tips & Notes" />
  </a>
  <nav>
    <ul>
      {
        lessons.map((lesson) => {
          const href = `${prefix}/lessons/${lesson.id}`;
          const isActive = pathname === href || pathname === `${href}/`;
          const { icon, color } = iconMap.get(lesson.id)!;
          const LessonIcon = ICONS[icon as keyof typeof ICONS];
          return (
            <li>
              <a href={href} class:list={{ active: isActive }}>
                <LessonIcon size={16} color={color} class="lesson-icon" />
                {lesson.data.title}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</aside>

<script>
  function initSidebar() {
    const sidebar = document.getElementById("sidebar");
    const toggle = document.getElementById("sidebar-toggle");
    const backdrop = document.getElementById("sidebar-backdrop");
    if (!sidebar || !toggle || !backdrop) return;

    const closeSidebar = () => {
      sidebar.classList.remove("open");
      backdrop.classList.remove("visible");
      toggle.setAttribute("aria-expanded", "false");
    };

    const openSidebar = () => {
      sidebar.classList.add("open");
      backdrop.classList.add("visible");
      toggle.setAttribute("aria-expanded", "true");
    };

    toggle.addEventListener("click", () => {
      if (sidebar.classList.contains("open")) {
        closeSidebar();
      } else {
        openSidebar();
      }
    });

    backdrop.addEventListener("click", closeSidebar);

    sidebar.querySelectorAll("nav a").forEach((link) => {
      link.addEventListener("click", closeSidebar);
    });

    const active = sidebar.querySelector("nav a.active");
    if (active) {
      active.scrollIntoView({ block: "center" });
    }
  }

  document.addEventListener("astro:page-load", initSidebar);
</script>

<style>
  .sidebar {
    width: var(--sidebar-width);
    min-width: var(--sidebar-width);
    height: 100vh;
    overflow-y: auto;
    background: var(--color-surface-dark);
    color: var(--color-text-inverse);
    padding: var(--space-9) 0;
    position: fixed;
    left: 0;
    top: 0;
  }

  .logo {
    display: block;
    padding: var(--space-7) var(--space-11);
    border-bottom: 1px solid var(--color-border-dark);
    margin-bottom: var(--space-4);
  }

  .logo img {
    display: block;
    height: 40px;
    width: auto;
  }

  nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  nav li {
    padding: 0;
  }

  nav a {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-11);
    color: var(--color-text-subtle);
    font-size: var(--font-size-sm-alt);
    transition:
      color var(--transition-fast),
      background var(--transition-fast);

    &:hover {
      color: var(--color-text-inverse);
      background: var(--color-surface-dark-hover);
    }

    &.active {
      color: var(--color-text-inverse-strong);
      background: var(--color-accent);
      font-weight: var(--font-weight-semibold);
    }
  }

  .lesson-icon {
    flex-shrink: 0;
  }

  .sidebar-toggle {
    display: none;
    position: fixed;
    top: var(--space-7);
    left: var(--space-9);
    z-index: 1001;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-dark);
    color: var(--color-text-inverse);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: left var(--transition-slow);

    &[aria-expanded="true"] {
      left: 226px;

      :global(.icon-open) {
        display: none;
      }

      :global(.icon-close) {
        display: block;
      }
    }

    :global(.icon-close) {
      display: none;
    }
  }

  .sidebar-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--color-overlay);
    z-index: 999;

    &.visible {
      display: block;
    }
  }

  @media (max-width: 768px) {
    .sidebar-toggle {
      display: flex;
    }

    .sidebar {
      transform: translateX(-100%);
      transition: transform var(--transition-slow);
      z-index: 1000;
      box-shadow: var(--shadow-lg);

      &.open {
        transform: translateX(0);
      }
    }
  }
</style>
