---
import { Search } from "reicon-astro";

interface Props {
  placeholder: string;
  noResultsText: string;
}

const { placeholder, noResultsText } = Astro.props;
---

<div class="lesson-search-wrapper">
  <input
    type="search"
    id="lesson-search"
    class="lesson-search"
    placeholder={placeholder}
    aria-label={placeholder}
  />
  <Search size={18} class="lesson-search-icon" />
</div>
<p class="no-results" id="no-results" hidden>{noResultsText}</p>

<script>
  function initLessonSearch() {
    const input = document.getElementById("lesson-search") as HTMLInputElement | null;
    const list = document.getElementById("lesson-list");
    const noResults = document.getElementById("no-results");
    if (!input || !list || !noResults) return;

    const items = Array.from(list.querySelectorAll<HTMLLIElement>("li[data-title]"));

    const filter = () => {
      const query = input.value.trim().toLowerCase();
      let visibleCount = 0;

      items.forEach((item) => {
        const matches = query === "" || (item.dataset.title ?? "").includes(query);
        item.hidden = !matches;
        if (matches) visibleCount++;
      });

      noResults.hidden = visibleCount !== 0;
    };

    let debounceTimer: ReturnType<typeof setTimeout>;
    input.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(filter, 200);
    });

    filter();
  }

  document.addEventListener("astro:page-load", initLessonSearch);
</script>

<style>
  .lesson-search-wrapper {
    position: relative;
    margin-bottom: var(--space-9);
  }

  .lesson-search {
    display: block;
    width: 100%;
    padding: var(--space-6) var(--space-15) var(--space-6) var(--space-9);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: var(--font-size-base);
    box-sizing: border-box;

    &:focus {
      outline: none;
      border-color: var(--color-accent);
      background: var(--color-bg);
    }
  }

  .lesson-search-icon {
    position: absolute;
    top: 50%;
    right: var(--space-8);
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .no-results {
    color: var(--color-text-muted);
    margin-top: var(--space-9);
  }
</style>
