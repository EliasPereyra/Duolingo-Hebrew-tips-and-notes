---
interface Props {
  locale: "en" | "es";
}

const { locale } = Astro.props;

const copy = {
  en: {
    title: "Search the notes",
    intro: "Search every lesson for a word or phrase, in English or Hebrew.",
    unavailable: "Search is available on the built site (run pnpm build && pnpm preview).",
    placeholder: "Search for a word, e.g. כלב or adjectives",
  },
  es: {
    title: "Buscar en las notas",
    intro: "Busca una palabra o frase en todas las lecciones, en español o en hebreo.",
    unavailable: "La búsqueda funciona en el sitio compilado (ejecuta pnpm build && pnpm preview).",
    placeholder: "Busca una palabra, p. ej. כלב o adjetivos",
  },
}[locale];
---

<main>
  <h1>{copy.title}</h1>
  <p class="intro">{copy.intro}</p>
  <div id="search" data-placeholder={copy.placeholder}></div>
  <p class="unavailable" id="search-unavailable" hidden>{copy.unavailable}</p>
</main>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

<script is:inline data-astro-rerun>
  (function () {
    const container = document.getElementById("search");
    const unavailable = document.getElementById("search-unavailable");
    if (!container) return;

    const start = () => {
      // eslint-disable-next-line no-undef
      new PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        translations: { placeholder: container.dataset.placeholder },
      });
      const query = new URLSearchParams(location.search).get("q");
      if (query) {
        const input = container.querySelector("input");
        if (input) {
          input.value = query;
          input.dispatchEvent(new Event("input", { bubbles: true }));
        }
      }
    };

    // The index only exists after `pagefind` runs on the build output.
    if (window.PagefindUI) return start();
    const script = document.createElement("script");
    script.src = "/pagefind/pagefind-ui.js";
    script.onload = start;
    script.onerror = () => {
      if (unavailable) unavailable.hidden = false;
    };
    document.head.appendChild(script);
  })();
</script>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-14);
  }

  h1 {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-5);
  }

  .intro {
    color: var(--color-text-muted);
    margin-bottom: var(--space-13);
  }

  .unavailable {
    padding: var(--space-9) var(--space-11);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }

  /* Pagefind UI themed with the site's design tokens. */
  #search {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-bg);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-bg-subtle);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius-md);
    --pagefind-ui-font: var(--font-sans);
  }

  #search :global(mark) {
    background: var(--color-accent-bg);
    color: var(--color-text-heading);
    border-radius: 2px;
  }

  #search :global(.pagefind-ui__search-clear) {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-family: inherit;
    cursor: pointer;
  }

  #search :global(.pagefind-ui__search-clear:hover) {
    color: var(--color-accent);
  }

  #search :global(.pagefind-ui__result-link) {
    font-family: var(--font-serif);
  }

  @media (max-width: 768px) {
    main {
      padding: var(--space-12) var(--space-11);
    }
  }
</style>
