---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import LessonPage from "../../components/LessonPage.astro";
import "../../styles/lesson.css";
import { buildPracticeIndex } from "../../utils/practice-data";
import { sortByCourseOrder } from "../../utils/course-order";

export async function getStaticPaths() {
  const lessons = sortByCourseOrder(await getCollection("lessons"));
  const practiceIndex = await buildPracticeIndex(lessons, "en");
  const link = (entry?: (typeof lessons)[number]) => entry && { id: entry.id, title: entry.data.title };
  return lessons.map((lesson, index) => ({
    params: { slug: lesson.id },
    props: {
      lesson,
      practice: practiceIndex.get(lesson.id),
      prev: link(lessons[index - 1]),
      next: link(lessons[index + 1]),
    },
  }));
}

const { lesson, practice, prev, next } = Astro.props;
---

<Layout title={`${lesson.data.title} - Hebrew Tips & Notes`}>
  <LessonPage locale="en" lesson={lesson} practice={practice} prev={prev} next={next} />
</Layout>
