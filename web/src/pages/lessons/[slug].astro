---
import { getCollection, render } from "astro:content";
import { ArrowLeft } from "reicon-astro";
import Layout from "../../layouts/Layout.astro";
import Practice from "../../components/Practice.astro";
import { buildPracticeIndex } from "../../utils/practice-data";
import { TIPS_AND_NOTES_MD, ORIGINAL_HTML_VERSION } from "../../constants/external-links";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  const practiceIndex = await buildPracticeIndex(lessons, "en");
  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
    props: { lesson, practice: practiceIndex.get(lesson.id) },
  }));
}

const { lesson, practice } = Astro.props;

const { Content } = await render(lesson);
---

<Layout title={`${lesson.data.title} - Hebrew Tips & Notes`}>
  <div class:list={["lesson-layout", { "has-practice": practice }]}>
  <article class="lesson">
    <div class="lesson-header">
      <a href="/" class="back-link">
        <ArrowLeft size={16} />
        Back to lessons
      </a>
      <div class="external-links">
        <a href={TIPS_AND_NOTES_MD} target="_blank" rel="noopener noreferrer">Source Markdown</a>
        <a href={ORIGINAL_HTML_VERSION} target="_blank" rel="noopener noreferrer">Full HTML version</a>
      </div>
    </div>

    <div class="lesson-content">
      <Content />
    </div>
  </article>

  {
    practice && (
      <aside class="lesson-practice">
        <Practice data={practice} />
      </aside>
    )
  }
  </div>
</Layout>

<style is:global>
  .lesson {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-14);
  }

  /* Below the two-column breakpoint the practice panel sits under the lesson. */
  .lesson-practice {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--space-14) var(--space-14);
  }

  @media (min-width: 1280px) {
    .lesson-layout.has-practice {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 22rem;
      gap: var(--space-15);
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--space-14);

      .lesson {
        max-width: none;
        margin: 0;
        padding-inline: 0;
      }

      /* Starts below the fixed language switcher and follows the reader down the lesson. */
      .lesson-practice {
        max-width: none;
        margin: 0;
        padding: calc(var(--space-16) + var(--space-9)) 0 var(--space-14);
      }

      .practice {
        position: sticky;
        top: calc(var(--space-16) + var(--space-9));
        max-height: calc(100vh - var(--space-16) - var(--space-14));
        overflow-y: auto;
      }
    }
  }

  .lesson-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-14);
    padding-bottom: var(--space-9);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-base);
  }

  .external-links {
    display: flex;
    gap: var(--space-9);
  }

  .external-links a {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
  }

  @media (max-width: 768px) {
    .lesson {
      padding: var(--space-11);
    }

    .lesson-practice {
      padding: 0 var(--space-11) var(--space-11);
    }

    .lesson-header {
      flex-wrap: wrap;
      align-items: flex-start;
      gap: var(--space-7);
    }
  }

  .lesson-content {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);

    h2 {
      font-size: var(--font-size-2xl);
      margin: var(--space-15) 0 var(--space-11);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--color-border-subtle);
      color: var(--color-text-heading);

      &:first-child {
        margin-top: 0;
      }
    }

    h3 {
      font-size: var(--font-size-xl);
      margin: var(--space-13) 0 var(--space-8);
      color: var(--color-text-heading);
    }

    p {
      margin: 0 0 var(--space-12);
    }

    .table-wrapper {
      margin: var(--space-11) 0 var(--space-12);
      overflow-x: auto;
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-md);
    }

    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }

    th,
    td {
      padding: var(--space-8) var(--space-10);
      border-bottom: 1px solid var(--color-border-subtle);
      border-right: 1px solid var(--color-border-subtle);
      text-align: left;
    }

    tr:last-child td {
      border-bottom: none;
    }

    th:last-child,
    td:last-child {
      border-right: none;
    }

    th {
      background: var(--color-bg-subtle);
      font-weight: var(--font-weight-semibold);
      color: var(--color-text-heading);
    }

    tbody tr:hover {
      background: var(--color-bg-hover);
    }

    blockquote,
    p.example {
      margin: var(--space-11) 0;
      padding: var(--space-7) var(--space-10);
      border-left: 3px solid var(--color-quote-border);
      background: var(--color-quote-bg);
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      color: var(--color-text-heading);

      p {
        margin: 0;

        & + p {
          margin-top: var(--space-4);
        }
      }
    }

    ul,
    ol {
      margin: 0 0 var(--space-10);
      padding-left: var(--space-13);
    }

    li {
      margin: var(--space-3) 0;

      p {
        margin: 0;

        & + p {
          margin-top: var(--space-3);
        }
      }
    }

    hr {
      border: none;
      border-top: 1px solid var(--color-border-subtle);
      margin: var(--space-14) 0;
    }

    img {
      max-width: 100%;
      height: auto;
    }
  }
</style>
