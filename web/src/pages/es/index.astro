---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import LessonSearch from "../../components/LessonSearch.astro";

const lessons = await getCollection("lessonsEs");
lessons.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Hebreo: Consejos y Notas" locale="es">
  <main>
    <h1>Hebreo: Consejos y Notas</h1>
    <p class="subtitle">
      Consejos y notas completos del curso de hebreo de Duolingo. Estas notas fueron eliminadas de
      Duolingo y se conservan aquí como referencia.
    </p>

    <section>
      <h2>Todas las lecciones</h2>
      <LessonSearch placeholder="Buscar lecciones..." noResultsText="No se encontraron lecciones." />
      <ul class="lesson-list" id="lesson-list">
        {
          lessons.map((lesson) => (
            <li data-title={lesson.data.title.toLowerCase()}>
              <a href={`/es/lessons/${lesson.id}`}>{lesson.data.title}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-14);
  }

  h1 {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-4);
  }

  .subtitle {
    color: var(--color-text-muted);
    margin-bottom: var(--space-14);
    line-height: var(--line-height-base);
  }

  .lesson-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .lesson-list a {
    display: block;
    padding: var(--space-7) var(--space-9);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    font-size: var(--font-size-base);
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast);

    &:hover {
      background: var(--color-bg);
      border-color: var(--color-accent);
    }
  }

  @media (max-width: 768px) {
    main {
      padding: var(--space-12) var(--space-11);
    }
  }
</style>
