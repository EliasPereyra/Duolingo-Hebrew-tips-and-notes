---
import { getCollection, render } from "astro:content";
import { ArrowLeft } from "reicon-astro";
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/lesson.css";
import Practice from "../../../components/Practice.astro";
import { buildPracticeIndex } from "../../../utils/practice-data";
import { TIPS_AND_NOTES_MD, ORIGINAL_HTML_VERSION } from "../../../constants/external-links";

export async function getStaticPaths() {
  const lessons = await getCollection("lessonsEs");
  const practiceIndex = await buildPracticeIndex(lessons, "es");
  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
    props: { lesson, practice: practiceIndex.get(lesson.id) },
  }));
}

const { lesson, practice } = Astro.props;

const { Content } = await render(lesson);
---

<Layout title={`${lesson.data.title} - Hebreo: Consejos y Notas`} locale="es">
  <div class:list={["lesson-layout", { "has-practice": practice }]}>
  <article class="lesson">
    <div class="lesson-header">
      <a href="/es" class="back-link">
        <ArrowLeft size={16} />
        Volver a las lecciones
      </a>
      <div class="external-links">
        <a href={TIPS_AND_NOTES_MD} target="_blank" rel="noopener noreferrer">Markdown original</a>
        <a href={ORIGINAL_HTML_VERSION} target="_blank" rel="noopener noreferrer">Versión HTML completa</a>
      </div>
    </div>

    <div class="lesson-content">
      <Content />
    </div>
  </article>

  {
    practice && (
      <aside class="lesson-practice">
        <Practice data={practice} locale="es" />
      </aside>
    )
  }
  </div>
</Layout>
