---
import { Font } from "astro:assets";
import { ClientRouter, slide } from "astro:transitions";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Complete Tips and Notes from the Duolingo Hebrew course" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-david-libre" />
    <ClientRouter />
  </head>
  <body>
    <Sidebar />
    <div class="content" transition:animate={slide({ duration: "0.2s" })}>
      <slot />
    </div>
  </body>
</html>
<style is:global>
  html {
    font-family:
      var(--font-manrope),
      var(--font-david-libre),
      system-ui,
      -apple-system,
      sans-serif;
    font-weight: 400;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  strong,
  b {
    font-weight: 700;
  }

  body {
    margin: 0;
    display: flex;
  }

  .content {
    margin-left: 280px;
    flex: 1;
    min-height: 100vh;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .content {
      margin-left: 0;
      padding-top: 3.5rem;
    }
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  a {
    color: #0366d6;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
