---
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Complete Tips and Notes from the Duolingo Hebrew course" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <Sidebar />
    <div class="content">
      <slot />
    </div>
  </body>
</html>
<style is:global>
  html {
    font-family: system-ui, -apple-system, sans-serif;
  }

  body {
    margin: 0;
    display: flex;
  }

  .content {
    margin-left: 280px;
    flex: 1;
    min-height: 100vh;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  a {
    color: #0366d6;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
