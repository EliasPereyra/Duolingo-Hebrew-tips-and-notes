---
import { Font } from "astro:assets";
import { ClientRouter, slide } from "astro:transitions";
import { Globe, ChevronDown, Sun, Moon } from "reicon-astro";
import Sidebar from "../components/Sidebar.astro";
import { descriptions, languageOptions } from "../constants/page-details";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  locale?: "en" | "es";
}

const { title, locale = "en" } = Astro.props;
const pathname = Astro.url.pathname;
const basePath = pathname.replace(/^\/es(\/|$)/, "/");
const localeHrefs = {
  en: basePath,
  es: basePath === "/" ? "/es" : `/es${basePath}`,
};
const site = Astro.site ?? Astro.url;
const canonical = new URL(pathname, site).href;
const ogImage = new URL("/og.png", site).href;
const description = descriptions[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline define:vars={{ locale, basePath }}>
      (function () {
        try {
          let stored = localStorage.getItem("preferredLocale");
          if (!stored) {
            const browserLang = (navigator.language || "").toLowerCase();
            stored = browserLang.indexOf("es") === 0 ? "es" : "en";
            localStorage.setItem("preferredLocale", stored);
          }
          if (stored !== locale) {
            const target = stored === "es" ? (basePath === "/" ? "/es" : "/es" + basePath) : basePath;
            location.replace(target + location.search + location.hash);
          }
        } catch {
          // localStorage unavailable (private browsing, blocked storage, etc.) - skip detection
        }
      })();
    </script>
    <script is:inline>
      // Apply the reader's saved theme before first paint, and again on every
      // client-side navigation (the router swaps in the new page's <html>).
      (function () {
        if (window.__themeInit) return;
        window.__themeInit = true;
        const getStored = () => {
          try {
            const theme = localStorage.getItem("theme");
            return theme === "light" || theme === "dark" ? theme : null;
          } catch {
            return null; // storage blocked: fall back to the OS preference
          }
        };
        const apply = (root) => {
          const theme = getStored();
          if (theme) root.dataset.theme = theme;
        };
        apply(document.documentElement);
        document.addEventListener("astro:before-swap", (event) => apply(event.newDocument.documentElement));
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(localeHrefs.en, site).href} />
    <link rel="alternate" hreflang="es" href={new URL(localeHrefs.es, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(localeHrefs.en, site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hebrew Tips & Notes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>{title}</title>
    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-frank-ruhl" preload />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === "es" ? "Saltar al contenido" : "Skip to content"}</a>
    <Sidebar locale={locale} />
    <div class="top-controls">
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label={locale === "es" ? "Cambiar entre tema claro y oscuro" : "Switch between light and dark theme"}
        title={locale === "es" ? "Cambiar tema" : "Toggle theme"}
      >
        <Moon size={16} class="theme-icon-moon" />
        <Sun size={16} class="theme-icon-sun" />
      </button>
      <div class="lang-switcher" id="lang-switcher">
        <button
          type="button"
          class="lang-toggle"
          id="lang-switcher-toggle"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={locale === "es" ? "Cambiar idioma" : "Change language"}
        >
          <Globe size={16} />
          <span>{locale.toUpperCase()}</span>
          <ChevronDown size={14} class="lang-chevron" />
        </button>
        <ul class="lang-menu" id="lang-menu" role="menu">
          {
            languageOptions.map((option) => (
              <li role="none">
                <a
                  href={localeHrefs[option.code]}
                  role="menuitem"
                  data-locale={option.code}
                  class:list={{ active: locale === option.code }}
                >
                  {option.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="content" id="main-content" tabindex="-1" transition:animate={slide({ duration: "0.2s" })}>
      <slot />
    </div>
  </body>
</html>

<script>
  import { initAudioPlayback } from "../utils/audio-player";
  import { markReadLessons } from "../utils/reading-progress";

  // Document-level listeners are tied to the current page and removed before
  // the router swaps in the next one, so they don't pile up across navigations.
  let pageListeners = new AbortController();
  document.addEventListener("astro:before-swap", () => {
    pageListeners.abort();
    pageListeners = new AbortController();
  });

  function initLangSwitcher() {
    const switcher = document.getElementById("lang-switcher");
    const toggle = document.getElementById("lang-switcher-toggle");
    const menu = document.getElementById("lang-menu");
    if (!switcher || !toggle || !menu) return;

    const items = Array.from(menu.querySelectorAll<HTMLAnchorElement>("a[role='menuitem']"));
    const { signal } = pageListeners;

    const isOpen = () => switcher.classList.contains("open");

    const closeMenu = (returnFocus = false) => {
      switcher.classList.remove("open");
      toggle.setAttribute("aria-expanded", "false");
      if (returnFocus) toggle.focus();
    };

    const openMenu = (focusIndex?: number) => {
      switcher.classList.add("open");
      toggle.setAttribute("aria-expanded", "true");
      if (focusIndex !== undefined) items.at(focusIndex)?.focus();
    };

    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      if (isOpen()) {
        closeMenu();
      } else {
        openMenu(event.detail === 0 ? 0 : undefined); // keyboard "click" focuses the first item
      }
    });

    // Menu-button keyboard pattern: arrows open the menu and move between items.
    toggle.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        openMenu(0);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        openMenu(-1);
      }
    });

    menu.addEventListener("keydown", (event) => {
      const index = items.indexOf(document.activeElement as HTMLAnchorElement);
      const moves: Record<string, number> = {
        ArrowDown: (index + 1) % items.length,
        ArrowUp: (index - 1 + items.length) % items.length,
        Home: 0,
        End: items.length - 1,
      };
      if (event.key in moves) {
        event.preventDefault();
        items[moves[event.key]]?.focus();
      } else if (event.key === "Tab") {
        closeMenu();
      }
    });

    document.addEventListener(
      "click",
      (event) => {
        if (!switcher.contains(event.target as Node)) closeMenu();
      },
      { signal },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape" && isOpen()) closeMenu(true);
      },
      { signal },
    );

    items.forEach((link) => {
      link.addEventListener("click", () => {
        try {
          localStorage.setItem("preferredLocale", link.dataset.locale ?? "en");
        } catch {
          // localStorage unavailable - the choice just won't be remembered
        }
      });
    });
  }

  function initThemeToggle() {
    const toggle = document.getElementById("theme-toggle");
    if (!toggle) return;

    toggle.addEventListener("click", () => {
      const root = document.documentElement;
      const current =
        root.dataset.theme ?? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      const next = current === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        // localStorage unavailable - the choice lasts until the next full page load
      }
    });
  }

  document.addEventListener("astro:page-load", initLangSwitcher);
  document.addEventListener("astro:page-load", initThemeToggle);
  document.addEventListener("astro:page-load", markReadLessons);

  initAudioPlayback();
</script>
